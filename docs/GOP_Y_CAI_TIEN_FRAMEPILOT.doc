  .highlight-box {
    background-color: #EBF8FF;
    border: 1px solid #BEE3F8;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 12px 0 16px 0;
  }
  .problem-box {
    background-color: #FFF5F5;
    border-left: 4px solid #E53E3E;
    padding: 10px 14px;
